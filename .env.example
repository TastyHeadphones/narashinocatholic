# docker compose が読み込む設定例。コピーして .env として使う（.env はコミットしない）。
# 本番環境では必ず別の値にしてください。

# ローカルの公開ポートとURL
WP_PORT=8080
WP_URL=http://localhost:8080

# サイトの表示名と管理者（初回インストール時のみ使われます）
WP_TITLE=カトリック習志野教会
WP_ADMIN_USER=admin
# 必ず設定してください。空欄のままではインストールされません。
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.com

# データベース
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# デバッグ表示（true で有効）
WP_DEBUG=
